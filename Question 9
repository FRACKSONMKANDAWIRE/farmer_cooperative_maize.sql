-- ---------------------------------------------------------------------
-- (g) Scheduled job [6 marks]
-- Recalculated from deliveries and REPLACED on conflict, never added.
-- ---------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE pr_refresh_purchases(p_day DATE)
LANGUAGE plpgsql
AS $$
BEGIN
    IF p_day IS NULL THEN
        RAISE EXCEPTION 'p_day is required';
    END IF;

    INSERT INTO daily_purchases (purchase_date, total_weight, total_value)
    SELECT p_day,
           COALESCE(SUM(weight_kg), 0),
           COALESCE(SUM(total_value), 0)
    FROM deliveries
    WHERE delivered_on = p_day
    ON CONFLICT (purchase_date) DO UPDATE
    SET total_weight = EXCLUDED.total_weight,
        total_value  = EXCLUDED.total_value;
END;
$$;

CALL pr_refresh_purchases(DATE '2026-11-23');
CALL pr_refresh_purchases(DATE '2026-11-24');
CALL pr_refresh_purchases(DATE '2026-11-24');   -- rerun replaces, does not add
SELECT * FROM daily_purchases ORDER BY purchase_date;
-- 2026-11-23 | 1900.00 | 8200.00
-- 2026-11-24 | 1300.00 | 4600.00

-- Schedule daily at 01:30 for the previous day (requires pg_cron)
ALTER PROCEDURE q9.pr_refresh_purchases(DATE) SET search_path = q9;
CREATE EXTENSION IF NOT EXISTS pg_cron;
SELECT cron.schedule(
    'q9_refresh_daily_purchases',
    '30 1 * * *',
    $$CALL q9.pr_refresh_purchases((CURRENT_DATE - 1)::date)$$
);
