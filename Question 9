-- ---------------------------------------------------------------------
-- (e) View [5 marks]
-- Unpaid filter in the LEFT JOIN's ON clause keeps every farmer;
-- COALESCE shows 0 for farmers with nothing unpaid.
-- ---------------------------------------------------------------------
CREATE OR REPLACE VIEW v_farmer_amount_due AS
SELECT f.farmer_number,
       f.full_name,
       COALESCE(SUM(d.total_value), 0) AS amount_due
FROM farmers f
LEFT JOIN deliveries d
       ON d.farmer_id = f.farmer_id
      AND d.is_paid = FALSE
GROUP BY f.farmer_id, f.farmer_number, f.full_name;

SELECT * FROM v_farmer_amount_due ORDER BY farmer_number;
-- F001 | 5000.00 F002 | 3400.00 F003 | 0

