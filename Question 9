-- ---------------------------------------------------------------------
-- (a) Database and seed data [6 marks]
-- unit_rate / total_value are NOT NULL: the BEFORE trigger fills them in
-- before constraints are checked.
-- ---------------------------------------------------------------------
CREATE TABLE farmers (
    farmer_id     SERIAL PRIMARY KEY,
    farmer_number VARCHAR(20)  NOT NULL UNIQUE,
    full_name     VARCHAR(100) NOT NULL
);

CREATE TABLE deliveries (
    delivery_id  SERIAL PRIMARY KEY,
    farmer_id    INTEGER NOT NULL REFERENCES farmers(farmer_id),
    grade        CHAR(1) NOT NULL CHECK (grade IN ('A', 'B', 'C')),
    weight_kg    NUMERIC(10,2) NOT NULL CHECK (weight_kg > 0),
    unit_rate    NUMERIC(10,2) NOT NULL CHECK (unit_rate > 0),
    total_value  NUMERIC(14,2) NOT NULL CHECK (total_value >= 0),
    delivered_on DATE NOT NULL DEFAULT CURRENT_DATE,
    is_paid      BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE TABLE daily_purchases (
    purchase_date DATE PRIMARY KEY,
    total_weight  NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (total_weight >= 0),
    total_value   NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (total_value >= 0)
);

